{
  "name": "agent-escrow",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:browser": "pnpm --filter @agent-escrow/web test:browser",
    "dev:chain": "tsx e2e/dev-chain.ts",
    "promo": "tsx apps/web/promo/record.ts",
    "dev:web": "VITE_RPC_URL=http://127.0.0.1:8899 pnpm --filter @agent-escrow/web dev",
    "build": "pnpm --filter @agent-escrow/web build && pnpm --filter agent-escrow-mcp build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@agent-escrow/checks": "workspace:*",
    "@agent-escrow/sdk": "workspace:*",
    "@biomejs/biome": "^2.5.15",
    "@modelcontextprotocol/client": "^2.3.0",
    "@solana-program/token": "^0.17.0",
    "@solana/kit": "^8.4.0",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
